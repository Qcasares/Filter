# Hemisphere API environment. Set these in the Vercel project settings.
# Owner: Quentin Casares.

# Shared secret. Must match the API key entered in the extension options page.
API_KEY=

# Anthropic Messages API.
ANTHROPIC_API_KEY=
# Cheapest current Haiku-class model id. Never hard-coded in the source.
LLM_MODEL=claude-haiku-4-5-20251001

# Vercel KV (Upstash) REST credentials. Provided automatically when you attach a
# KV store to the project. Without them the API falls back to an in-memory store
# (fine for local testing, not for production).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Cost and abuse controls (optional; defaults shown).
DAILY_CAP_USD=0.50
RATE_LIMIT=60
LLM_INPUT_COST_PER_MTOK=0.80
LLM_OUTPUT_COST_PER_MTOK=4.00
